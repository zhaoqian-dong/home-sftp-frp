# ============================================================================
# home-sftp-frp 统一配置文件
#
# 用法：
#   1. 复制本文件为 .env（cp .env.example .env），按注释填写
#   2. 同一份 .env 需要放到两个地方（与脚本同目录）：
#        - 公网 VPS（配合 scripts/setup-vps.sh）
#        - 家里 Windows 机器（配合 scripts/windows/*.ps1）
# ============================================================================

# ---- 公网 VPS ----
# 腾讯云轻量应用服务器的公网 IP（必填，见 docs/vps-rental-guide.md）
VPS_IP=

# ---- frp 隧道 ----
# frpc <-> frps 控制通道端口（VPS 腾讯云控制台防火墙需放行）
FRP_BIND_PORT=7000
# 隧道传输协议：tcp（默认）或 kcp。
# KCP 基于 UDP，在丢包率高的家宽/跨境线路上吞吐明显更好；
# 切换为 kcp 后，VPS 云端防火墙除 TCP 外还需放行 UDP FRP_BIND_PORT
# （云端 UDP/TCP 是两条独立规则，漏放 UDP 会连不上）
FRP_TRANSPORT=tcp
# 外网上传者实际连接的 SFTP 端口，即 VPS 上对外暴露的端口（需放行）
SFTP_PUBLIC_PORT=6022
# frp 通信令牌。留空时 setup-vps.sh 会自动生成并打印；
# 生成后请把该值回填到这里，再把 .env 同步到家里 Windows 机器
FRP_TOKEN=

# ---- 家里 Windows SFTP ----
# SFTP 数据根目录（每个上传账号一个独立子目录，互相隔离）
SFTP_ROOT=C:\SFTPData
# Windows 客户端脚本（setup-client.ps1）默认使用的上传账号名，
# 先在家里 Windows 上用 add-sftp-user.ps1 创建后再填
SFTP_USER=

# ---- 限速（可选）----
# 限制每个上传者的传输带宽，留空为不限。示例：5MB、500KB（每秒）。
# 用于防止单个上传者占满 VPS 或家庭上行带宽
SFTP_BANDWIDTH_LIMIT=
